# Copy to .env and enter your key locally. Never commit .env.
YOUTUBE_API_KEY=
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
WEB_PORT=18501
# Contact details sent as User-Agent to KPRM, Hacker News, Wykop and CLARIN-PL.
AMC_USER_AGENT=
# Wykop API v3 application (https://dev.wykop.pl). The salt is a long random string shared
# privately within the team and never changed: python -c "import secrets; print(secrets.token_hex(32))"
WYKOP_KEY=
WYKOP_SECRET=
WYKOP_SALT=
# CLARIN-PL API token (https://services.clarin-pl.eu) for stage 2 labelling, and a model
# from `python scripts/wykop/classify_stage2.py --list-models`.
CLARIN_TOKEN=
CLARIN_MODEL=deepseek-v4-flash-0731
# Azure OpenAI (Azure AI Foundry) for the stage 1 rerun (ai, work), scripts/wykop/classify_stage1_azure.py.
# Endpoint like https://<resource>.openai.azure.com; the deployment name is the model.
# Leave the API version empty for the v1 API, or set one for the /deployments/ route.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# 0 for gpt-4o; leave empty for reasoning models, which accept only the default.
AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REASONING_EFFORT=
# Answer limit, counted towards the quota: 50 without reasoning, 4000 (default) with it.
AZURE_OPENAI_MAX_TOKENS=50
